// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

// Packaging
INFOPLIST_FILE = Hammerspoon/Hammerspoon-Info.plist
PRODUCT_NAME = Hammerspoon
PRODUCT_BUNDLE_IDENTIFIER = org.hammerspoon.${PRODUCT_NAME:rfc1034identifier}
WRAPPER_EXTENSION = app

// Version information. This is expected to be overridden later based on git tag/commit
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 1.0

// App Icon Name
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Header Search Paths
HEADER_SEARCH_PATHS = $(inherited)/** "$(SDKROOT)/usr/include/libxml2" "$(SDK_DIR)"/usr/include/libxml2
// User Header Search Paths
USER_HEADER_SEARCH_PATHS = $(inherited)/**

// Code Signing Entitlements
CODE_SIGN_ENTITLEMENTS = Hammerspoon/Hammerspoon-dev.entitlements

// Code Signing Identity
CODE_SIGN_IDENTITY = -

// Development Team
DEVELOPMENT_TEAM =

// Enable Hardened Runtime
ENABLE_HARDENED_RUNTIME = YES

// Prefix Header — removed. Cocoa.h is implicitly available via CLANG_ENABLE_MODULES
// and LUA_USE_MACOSX is defined in LuaSkin's Package.swift.
GCC_PRECOMPILE_PREFIX_HEADER = NO

// SiriKit Intent (Shortcuts) generation language
INTENTS_CODEGEN_LANGUAGE = Objective-C

// The two Run Script phases on this target (Update version / Compile docs.json)
// both need filesystem access outside the sandbox: the first reads `.git` and
// writes Info.plist via PlistBuddy, the second walks the entire Hammerspoon/ and
// extensions/ source trees. Per-phase sandbox override isn't expressible in
// pbxproj, so opt the whole target out of script sandboxing while keeping it
// enabled project-wide for everything else.
ENABLE_USER_SCRIPT_SANDBOXING = NO

// Because all .m files are compiled by the HSExtensions SPM package (not the
// Xcode app target), the Sources build phase is empty. Xcode infers certain
// linker flags — ObjC runtime, sanitizer/profiling runtimes — from the
// presence of compiled sources. Without them, add the flags explicitly.
//
// -fobjc-arc / -fobjc-link-runtime: pull in the ObjC ARC runtime.
// -fsanitize=address,undefined: link the sanitizer runtimes when the scheme
//   enables sanitizers. Benign when sanitizers are off (no instrumented code
//   to trigger callbacks). -fprofile-instr-generate does the same for code-
//   coverage profiling.
OTHER_LDFLAGS = $(inherited) -fobjc-arc -fobjc-link-runtime -fprofile-instr-generate -fsanitize=address -fsanitize=undefined -weak_framework SkyLight -weak_framework DisplayServices -weak_framework CoreDisplay

// Private frameworks consumed by the brightness/screen/spaces extensions.
// CoreDisplay is a public framework that contains private (`CoreDisplay_*`)
// symbols; SkyLight and DisplayServices live under PrivateFrameworks and
// require an explicit framework search path. All three are linked with
// `-weak_framework` because the extensions guard each call site with
// `weak_import` null-checks (older macOS versions did not export every
// symbol).
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SDKROOT)/System/Library/PrivateFrameworks
