# Unified extension manifest for Hammerspoon
# Format: directory<TAB>entry-points<TAB>lua-files
# - directory: extension folder name under extensions/
#   entry-points: comma-separated luaopen_* symbols, or "-" if Lua-only
#   lua-files: comma-separated .lua filenames (relative to extensions/<directory>/)
#
# Special entries (non-extension files) use a full path prefixed with "@".
# For @-lines the lua-files column is a full repo-relative path.

@LuaSkin	-	Packages/LuaSkin/Sources/LuaSkin/Resources/luaskin.lua
_coresetup	-	_coresetup.lua
alert	-	alert.lua
appfinder	-	appfinder.lua
applescript	-	applescript.lua
