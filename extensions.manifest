# Unified extension manifest for Cosmic Hammer
# Format: scope<TAB>native-preloads<TAB>lua-modules<TAB>aliases
# - scope: extension folder name under extensions/, or @name for a special repo-relative source entry
# - native-preloads: comma-separated package.preload-key=luaopen_* symbols, or -
# - lua-modules: comma-separated module=source>bundle-path entries, or -
#   source is relative to extensions/<scope>/ unless scope starts with @; bundle-path is relative to Contents/Resources/extensions/hs/
# - aliases: comma-separated public-module=target-module preload aliases, or -

_coresetup	-	hs._coresetup=_coresetup.lua>_coresetup.lua,hs._boot=_boot.lua>_boot.lua,hs._loader_metadata=_loader_metadata.lua>_loader_metadata.lua	-
